# This file is an owned Bash rc file; user profiles stay in their normal locations.
__git_terminal_integration_dir=${BASH_SOURCE[0]%/*}
__git_terminal_integration_dir=$(builtin cd -- "$__git_terminal_integration_dir" && builtin pwd -P)
if [[ ${GIT_TERMINAL_LOAD_PROFILE:-1} == 1 ]]; then
  [[ ! -r /etc/profile ]] || builtin source /etc/profile
  for __git_terminal_profile in "$HOME/.bash_profile" "$HOME/.bash_login" "$HOME/.profile"; do
    if [[ -r $__git_terminal_profile ]]; then
      builtin source "$__git_terminal_profile"
      break
    fi
  done
  unset __git_terminal_profile
fi
if [[ ${GIT_TERMINAL_GIT_PROMPT:-1} == 1 ]]; then
  builtin source "$__git_terminal_integration_dir/prompt.bash"
fi
unset __git_terminal_integration_dir
